# AgriScan 3D — frontend environment template.
# Copy to .env.local (gitignored) and fill in real values. Every variable is
# optional: the app falls back to its built-in defaults when unset.
# NEVER commit real keys — .env / .env.local are gitignored on purpose.

# Remote YOLOv8 classifier endpoint used for anonymous scans (Cloud Run).
VITE_API_URL=

# API key for the remote classifier endpoint above.
VITE_API_KEY=

# FastAPI backend base URL for auth + prediction history + authenticated
# scans (defaults to http://localhost:8000 for local uvicorn development).
# NOTE: this is a SEPARATE service from VITE_API_URL — set it explicitly so
# auth/history calls are never sent to the classifier endpoint.
VITE_API_BASE_URL=
